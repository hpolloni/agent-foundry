{
  "name": "@agent-foundry/example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:mutation": "stryker run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "vitest": "5.1.0"
  }
}
